function filterCandidates(){
  const q=document.getElementById('searchCand').value.toLowerCase();
  const cls=document.getElementById('filterClass').value;
  filteredCandidates=CANDIDATES.filter(c=>{
    const matchQ=!q||c.tic.includes(q)||c.period.toString().includes(q);
    const matchC=!cls||c.cls===cls;
    return matchQ&&matchC;
  });
  const sort=document.getElementById('sortCand').value;
  if(sort.includes('SNR')) filteredCandidates.sort((a,b)=>b.snr-a.snr);
  else if(sort.includes('Period')) filteredCandidates.sort((a,b)=>a.period-b.period);
  else filteredCandidates.sort((a,b)=>b.conf-a.conf);
  renderCandidates();
}
