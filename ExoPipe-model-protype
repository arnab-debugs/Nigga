// ---- Synthetic Data ----
function generateLightCurve(n=300,period=3.47,depth=0.0146,noise=0.003){
  const t=[],f=[],fe=[];
  for(let i=0;i<n;i++){
    const time=i*(27/n);
    t.push(time);
    let flux=1.0+Math.sin(time*0.08)*0.002+(Math.random()-0.5)*noise;
    // add transits
    const phase=((time%period)/period);
    if(phase>0.45&&phase<0.55) flux-=depth*(1-Math.pow((phase-0.5)/0.05,2));
    f.push(flux);
    fe.push(noise*0.3);
  }
  return{t,f,fe};
}

function generateBLS(periods){
  return periods.map(p=>{
    let power=Math.exp(-Math.pow(Math.log(p/3.47),2)*8)*0.48;
    power+=Math.exp(-Math.pow(Math.log(p/7.03),2)*8)*0.22;
    power+=Math.exp(-Math.pow(Math.log(p/0.94),2)*8)*0.08;
    power+=Math.random()*0.015;
    return power;
  });
}

