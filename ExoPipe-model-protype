  });
}

function initCNNChart(){
  const phases=[],flux=[];
  for(let i=0;i<201;i++){
    const ph=(i/200)*8-4;
    let f=1.0+(Math.random()-0.5)*0.001;
    if(Math.abs(ph)<1.316){
      f-=0.0146;
      if(Math.abs(ph)>0.8725&&Math.abs(ph)<=1.316) f+=0.0146*(1-(1.316-Math.abs(ph))/0.4435);
    }
    phases.push(ph.toFixed(2));
    flux.push(f);
  }
  mkChart('cnnChart',{
    type:'line',
    data:{
      labels:phases,
      datasets:[{data:flux,borderColor:'#9f7aea',borderWidth:1.5,pointRadius:0,fill:{target:'origin',above:'rgba(159,122,234,0.05)'}}]
    },
    options:{
      responsive:true,maintainAspectRatio:false,
