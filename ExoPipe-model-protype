function initPhaseChart(){
  const phases=[],fluxes=[],scatterPts=[];
  for(let i=0;i<200;i++){
    const ph=(i/200)*2-1;
    let fl=1.0+(Math.random()-0.5)*0.0025;
    if(Math.abs(ph)<1){
      const depth=0.0146;
      if(ph>=-1&&ph<=-0.5) fl-=depth*Math.max(0,(ph+1)/0.5);
      else if(ph>-0.5&&ph<0.5) fl-=depth;
      else if(ph>=0.5&&ph<=1) fl-=depth*Math.max(0,(1-ph)/0.5);
    }
    phases.push(ph.toFixed(3));
    fluxes.push(fl);
    scatterPts.push({x:ph+(Math.random()-0.5)*0.08,y:fl+(Math.random()-0.5)*0.001});
  }
  mkChart('phaseChart',{
    type:'line',
    data:{
      labels:phases,
      datasets:[
        {label:'Model',data:fluxes,borderColor:'#fc8181',borderWidth:2,pointRadius:0,fill:false,order:1},
        {type:'scatter',label:'Data',data:scatterPts,backgroundColor:'rgba(99,179,237,0.5)',pointRadius:2,order:2}
