<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ExoPulse — ISRO PS7 Exoplanet Detection System</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style>
  :root {
    --bg: #0a0e1a;
    --bg2: #0f1525;
    --bg3: #131929;
    --card: #151c30;
    --card2: #1a2238;
    --border: rgba(99,179,237,0.15);
    --border2: rgba(99,179,237,0.3);
    --text: #e8edf5;
    --muted: #7a8ba8;
    --accent: #63b3ed;
    --accent2: #9f7aea;
    --gold: #f6d860;
    --green: #48bb78;
    --red: #fc8181;
    --orange: #f6ad55;
    --font: 'Segoe UI', system-ui, sans-serif;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    min-height: 100vh;
  }
  /* Starfield */
  #stars {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    pointer-events: none; z-index: 0; overflow: hidden;
  }
  .star {
    position: absolute; background: #fff; border-radius: 50%;
    animation: twinkle 3s infinite alternate;
  }
  @keyframes twinkle { 0% { opacity: 0.2; } 100% { opacity: 0.9; } }

  /* Layout */
  .shell { position: relative; z-index: 1; display: flex; min-height: 100vh; }
  nav {
    width: 220px; min-height: 100vh; background: var(--bg2);
    border-right: 1px solid var(--border);
    display: flex; flex-direction: column;
    position: fixed; left: 0; top: 0; bottom: 0;
    padding: 0 0 1.5rem;
  }
  .nav-logo {
    padding: 1.25rem 1rem;
    border-bottom: 1px solid var(--border);
    display: flex; align-items: center; gap: 10px;
  }
  .nav-logo-icon {
    width: 34px; height: 34px; border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    display: flex; align-items: center; justify-content: center;
    font-size: 16px;
  }
  .nav-logo h1 { font-size: 15px; font-weight: 700; color: var(--text); letter-spacing: 0.5px; }
  .nav-logo p { font-size: 10px; color: var(--muted); }
  .nav-section-label {
    font-size: 10px; font-weight: 600; text-transform: uppercase;
    letter-spacing: 1px; color: var(--muted); padding: 1rem 1rem 0.4rem;
  }
  .nav-item {
    display: flex; align-items: center; gap: 10px;
    padding: 0.55rem 1rem; cursor: pointer;
    font-size: 13px; color: var(--muted);
    border-left: 3px solid transparent;
    transition: all 0.15s;
  }
  .nav-item:hover { background: rgba(99,179,237,0.06); color: var(--text); }
  .nav-item.active {
    background: rgba(99,179,237,0.1);
    border-left-color: var(--accent);
    color: var(--accent);
  }
  .nav-item .ni { font-size: 15px; }
  .nav-spacer { flex: 1; }
  .nav-badge {
    margin: 0 1rem; padding: 0.6rem 0.75rem;
    background: rgba(159,122,234,0.12); border: 1px solid rgba(159,122,234,0.25);
    border-radius: 8px; font-size: 11px; color: var(--accent2);
  }
  .nav-badge strong { display: block; font-size: 12px; margin-bottom: 2px; }

  main { margin-left: 220px; flex: 1; padding: 2rem; }

  /* Section visibility */
  .section { display: none; }
  .section.active { display: block; }

  /* Page header */
  .page-header { margin-bottom: 2rem; }
  .page-header h2 { font-size: 22px; font-weight: 700; color: var(--text); margin-bottom: 4px; }
  .page-header p { font-size: 14px; color: var(--muted); }

  /* Cards */
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem;
  }
  .card-title {
    font-size: 12px; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.8px; color: var(--muted); margin-bottom: 1rem;
  }

  /* Metric row */
  .metric-row { display: grid; gap: 1rem; margin-bottom: 1.5rem; }
  .metric-row.cols4 { grid-template-columns: repeat(4, 1fr); }
  .metric-row.cols3 { grid-template-columns: repeat(3, 1fr); }
  .metric-row.cols2 { grid-template-columns: repeat(2, 1fr); }
  .metric {
    background: var(--card2); border: 1px solid var(--border);
    border-radius: 10px; padding: 1rem 1.1rem;
  }
  .metric label { font-size: 11px; color: var(--muted); display: block; margin-bottom: 4px; }
  .metric .val { font-size: 22px; font-weight: 700; }
  .metric .sub { font-size: 11px; color: var(--muted); margin-top: 2px; }
  .c-blue { color: var(--accent); }
  .c-purple { color: var(--accent2); }
  .c-gold { color: var(--gold); }
  .c-green { color: var(--green); }
  .c-red { color: var(--red); }
  .c-orange { color: var(--orange); }

  /* Grid layouts */
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .grid3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.25rem; }
  .grid-main { display: grid; grid-template-columns: 2fr 1fr; gap: 1.25rem; }

  /* Upload zone */
  .upload-zone {
    border: 2px dashed var(--border2); border-radius: 12px;
    padding: 3rem; text-align: center; cursor: pointer;
    transition: all 0.2s; background: var(--card);
  }
  .upload-zone:hover, .upload-zone.drag { border-color: var(--accent); background: rgba(99,179,237,0.05); }
  .upload-icon { font-size: 48px; margin-bottom: 1rem; opacity: 0.5; }
  .upload-zone h3 { font-size: 16px; margin-bottom: 0.5rem; }
  .upload-zone p { font-size: 13px; color: var(--muted); }

  /* Buttons */
  .btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 0.5rem 1.1rem; border-radius: 7px; border: none;
    font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.15s;
  }
  .btn-primary { background: var(--accent); color: #0a0e1a; }
  .btn-primary:hover { background: #90cdf4; }
  .btn-ghost {
    background: transparent; color: var(--muted);
    border: 1px solid var(--border); 
  }
  .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }
  .btn-purple { background: var(--accent2); color: #fff; }
  .btn-purple:hover { background: #b794f4; }
  .btn-sm { padding: 0.35rem 0.75rem; font-size: 12px; }
  .btn-row { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1rem; }

  /* Badges */
  .badge {
    display: inline-flex; align-items: center;
    font-size: 11px; font-weight: 600; padding: 2px 8px;
    border-radius: 20px;
  }
  .badge-green { background: rgba(72,187,120,0.15); color: var(--green); border: 1px solid rgba(72,187,120,0.3); }
  .badge-red { background: rgba(252,129,129,0.15); color: var(--red); border: 1px solid rgba(252,129,129,0.3); }
  .badge-orange { background: rgba(246,173,85,0.15); color: var(--orange); border: 1px solid rgba(246,173,85,0.3); }
  .badge-blue { background: rgba(99,179,237,0.15); color: var(--accent); border: 1px solid rgba(99,179,237,0.3); }
  .badge-purple { background: rgba(159,122,234,0.15); color: var(--accent2); border: 1px solid rgba(159,122,234,0.3); }

  /* Table */
  .data-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .data-table th {
    padding: 0.5rem 0.75rem; text-align: left;
    font-size: 11px; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.5px; color: var(--muted);
    border-bottom: 1px solid var(--border);
  }
  .data-table td { padding: 0.65rem 0.75rem; border-bottom: 1px solid rgba(99,179,237,0.06); }
  .data-table tr:hover td { background: rgba(99,179,237,0.04); }

  /* Progress bar */
  .progress-bar { height: 6px; background: var(--bg3); border-radius: 3px; overflow: hidden; }
  .progress-fill { height: 100%; border-radius: 3px; transition: width 0.4s; }

  /* Pipeline steps */
  .pipeline { display: flex; align-items: center; gap: 0; margin-bottom: 1.5rem; }
  .pipe-step {
    flex: 1; padding: 0.6rem 0.5rem; text-align: center;
    font-size: 11px; font-weight: 600;
    border: 1px solid var(--border); background: var(--card2);
    position: relative; cursor: pointer; transition: all 0.15s;
  }
  .pipe-step:not(:last-child)::after {
    content: '▶'; position: absolute; right: -10px; top: 50%;
    transform: translateY(-50%); z-index: 2;
    color: var(--muted); font-size: 10px; background: var(--bg);
    padding: 2px; line-height: 1;
  }
  .pipe-step:first-child { border-radius: 6px 0 0 6px; }
  .pipe-step:last-child { border-radius: 0 6px 6px 0; }
  .pipe-step.done { background: rgba(72,187,120,0.1); border-color: rgba(72,187,120,0.3); color: var(--green); }
  .pipe-step.active { background: rgba(99,179,237,0.15); border-color: var(--accent); color: var(--accent); }
  .pipe-step.pending { color: var(--muted); }
  .pipe-num { display: block; font-size: 18px; margin-bottom: 2px; }

  /* Chart containers */
  .chart-wrap { position: relative; width: 100%; }

  /* Slider */
  input[type=range] {
    width: 100%; accent-color: var(--accent);
    background: transparent; cursor: pointer;
  }

  /* Text areas & inputs */
  textarea, input[type=text], select {
    width: 100%; background: var(--bg3); border: 1px solid var(--border);
    color: var(--text); border-radius: 8px; padding: 0.6rem 0.8rem;
    font-family: var(--font); font-size: 13px; outline: none;
    transition: border-color 0.15s;
  }
  textarea:focus, input[type=text]:focus, select:focus { border-color: var(--accent); }
  textarea { resize: vertical; min-height: 80px; }
  select option { background: var(--bg2); }

  /* AI Copilot chat */
  .chat-messages {
    max-height: 320px; overflow-y: auto; padding: 0.75rem;
    display: flex; flex-direction: column; gap: 0.75rem;
  }
  .chat-msg {
    max-width: 85%; padding: 0.6rem 0.85rem;
    border-radius: 10px; font-size: 13px; line-height: 1.55;
  }
  .chat-msg.user {
    align-self: flex-end; background: rgba(99,179,237,0.2);
    border: 1px solid rgba(99,179,237,0.3); color: var(--text);
  }
  .chat-msg.ai {
    align-self: flex-start; background: var(--card2);
    border: 1px solid var(--border); color: var(--text);
  }
  .chat-msg.thinking { color: var(--muted); font-style: italic; }
  .chat-input-row { display: flex; gap: 0.5rem; padding: 0.75rem; border-top: 1px solid var(--border); }
  .chat-input-row input { flex: 1; }

  /* Confidence gauge */
  .gauge-wrap { text-align: center; }
  .gauge-label { font-size: 11px; color: var(--muted); margin-top: 0.4rem; }
  .gauge-val { font-size: 28px; font-weight: 700; }

  /* SHAP bars */
  .shap-item { margin-bottom: 0.6rem; }
  .shap-item label { font-size: 12px; color: var(--muted); display: flex; justify-content: space-between; margin-bottom: 3px; }
  .shap-pos { background: linear-gradient(90deg, var(--green), rgba(72,187,120,0.3)); border-radius: 3px; height: 8px; }
  .shap-neg { background: linear-gradient(90deg, var(--red), rgba(252,129,129,0.3)); border-radius: 3px; height: 8px; }

  /* Tabs */
  .tabs { display: flex; gap: 0; border-bottom: 1px solid var(--border); margin-bottom: 1.25rem; }
  .tab {
    padding: 0.55rem 1rem; font-size: 13px; cursor: pointer;
    color: var(--muted); border-bottom: 2px solid transparent;
    transition: all 0.15s; font-weight: 500;
  }
  .tab:hover { color: var(--text); }
  .tab.active { color: var(--accent); border-bottom-color: var(--accent); }
  .tab-panel { display: none; }
  .tab-panel.active { display: block; }

  /* Candidate cards */
  .candidate-card {
    background: var(--card2); border: 1px solid var(--border);
    border-radius: 10px; padding: 1rem; margin-bottom: 0.75rem;
    display: flex; align-items: center; gap: 1rem; cursor: pointer;
    transition: border-color 0.15s;
  }
  .candidate-card:hover { border-color: var(--accent); }
  .candidate-card.selected { border-color: var(--accent); background: rgba(99,179,237,0.06); }
  .cand-id {
    width: 46px; height: 46px; border-radius: 50%;
    background: rgba(99,179,237,0.15); border: 1px solid rgba(99,179,237,0.3);
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; font-weight: 700; color: var(--accent); flex-shrink: 0;
  }
  .cand-info { flex: 1; }
  .cand-info h4 { font-size: 13px; font-weight: 600; margin-bottom: 2px; }
  .cand-info p { font-size: 11px; color: var(--muted); }
  .cand-right { text-align: right; }

  /* Tooltip-like info box */
  .info-box {
    background: rgba(99,179,237,0.08); border: 1px solid rgba(99,179,237,0.2);
    border-radius: 8px; padding: 0.75rem; font-size: 12px; color: var(--muted);
    margin-top: 0.75rem;
  }
  .info-box strong { color: var(--accent); }

  /* Loading spinner */
  .spinner {
    width: 18px; height: 18px; border: 2px solid rgba(99,179,237,0.2);
    border-top-color: var(--accent); border-radius: 50%;
    animation: spin 0.7s linear infinite; display: inline-block;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* Scrollbar */
  ::-webkit-scrollbar { width: 5px; height: 5px; }
  ::-webkit-scrollbar-track { background: var(--bg2); }
  ::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 3px; }

  /* Responsive */
  @media (max-width: 900px) {
    nav { width: 60px; }
    .nav-item span:not(.ni) { display: none; }
    .nav-logo h1, .nav-logo p, .nav-section-label, .nav-badge { display: none; }
    .nav-logo { justify-content: center; padding: 1rem 0; }
    main { margin-left: 60px; padding: 1rem; }
    .metric-row.cols4 { grid-template-columns: 1fr 1fr; }
    .grid2, .grid-main { grid-template-columns: 1fr; }
    .grid3 { grid-template-columns: 1fr 1fr; }
  }

  .tag { display: inline-block; font-size: 10px; padding: 1px 6px; border-radius: 4px; background: var(--bg3); color: var(--muted); border: 1px solid var(--border); margin-right: 3px; }
</style>
</head>
<body>

<!-- Starfield -->
<div id="stars"></div>

<div class="shell">
<!-- Sidebar -->
<nav>
  <div class="nav-logo">
    <div class="nav-logo-icon">🪐</div>
    <div>
      <h1>ExoPulse</h1>
      <p>ISRO PS-7</p>
    </div>
  </div>

  <div class="nav-section-label">Pipeline</div>
  <div class="nav-item active" onclick="showSection('dashboard')">
    <span class="ni">📊</span><span>Dashboard</span>
  </div>
  <div class="nav-item" onclick="showSection('upload')">
    <span class="ni">📁</span><span>Upload Data</span>
  </div>
  <div class="nav-item" onclick="showSection('detrend')">
    <span class="ni">📈</span><span>Detrending</span>
  </div>
  <div class="nav-item" onclick="showSection('detection')">
    <span class="ni">🔍</span><span>Transit Detection</span>
  </div>
  <div class="nav-item" onclick="showSection('classification')">
    <span class="ni">🤖</span><span>Classification</span>
  </div>
  <div class="nav-section-label">Analysis</div>
  <div class="nav-item" onclick="showSection('explain')">
    <span class="ni">🧠</span><span>Explainability</span>
  </div>
  <div class="nav-item" onclick="showSection('candidates')">
    <span class="ni">🌍</span><span>Candidates</span>
  </div>
  <div class="nav-item" onclick="showSection('copilot')">
    <span class="ni">💬</span><span>AI Copilot</span>
  </div>

  <div class="nav-spacer"></div>
  <div class="nav-badge">
    <strong>🛰 TESS Active</strong>
    Sector 42 • 24h obs
  </div>
</nav>

<!-- Main content -->
<main>

<!-- DASHBOARD -->
<div class="section active" id="sec-dashboard">
  <div class="page-header">
    <h2>Mission Overview</h2>
    <p>Bharatiya Antariksh Hackathon 2026 — Problem Statement 7 · AI-enabled Exoplanet Detection</p>
  </div>

  <div class="pipeline">
    <div class="pipe-step done"><span class="pipe-num">✓</span>Load Data</div>
    <div class="pipe-step done"><span class="pipe-num">✓</span>Detrend</div>
    <div class="pipe-step active"><span class="pipe-num">▶</span>Detect</div>
    <div class="pipe-step pending"><span class="pipe-num">4</span>Extract</div>
    <div class="pipe-step pending"><span class="pipe-num">5</span>Classify</div>
    <div class="pipe-step pending"><span class="pipe-num">6</span>Validate</div>
  </div>

  <div class="metric-row cols4">
    <div class="metric">
      <label>Stars Analysed</label>
      <div class="val c-blue">2,847</div>
      <div class="sub">TESS Sector 42</div>
    </div>
    <div class="metric">
      <label>Transit Candidates</label>
      <div class="val c-gold">47</div>
      <div class="sub">from BLS algorithm</div>
    </div>
    <div class="metric">
      <label>Confirmed Planets</label>
      <div class="val c-green">12</div>
      <div class="sub">confidence ≥ 85%</div>
    </div>
    <div class="metric">
      <label>False Positives</label>
      <div class="val c-red">9</div>
      <div class="sub">eclipsing binaries</div>
    </div>
  </div>

  <div class="grid-main">
    <div class="card">
      <div class="card-title">Transit Candidate Light Curve — TIC 260128333</div>
      <div class="chart-wrap" style="height:220px">
        <canvas id="dashChart" role="img" aria-label="Light curve showing transit dips for star TIC 260128333"></canvas>
      </div>
      <div class="info-box" style="margin-top:0.75rem">
        <strong>Period:</strong> 3.47 d &nbsp;|&nbsp; <strong>Depth:</strong> 1.46% &nbsp;|&nbsp;
        <strong>Duration:</strong> 2.63 h &nbsp;|&nbsp; <strong>SNR:</strong> 14.2
      </div>
    </div>
    <div class="card">
      <div class="card-title">Classification Distribution</div>
      <div class="chart-wrap" style="height:180px">
        <canvas id="pieChart" role="img" aria-label="Pie chart of classification results"></canvas>
      </div>
      <div style="margin-top:0.75rem; display:flex; flex-direction:column; gap:6px;">
        <div style="display:flex;justify-content:space-between;font-size:12px">
          <span style="color:var(--green)">● Planet Transit</span><span>12 (25.5%)</span>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:12px">
          <span style="color:var(--red)">● EB / False Positive</span><span>9 (19.1%)</span>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:12px">
          <span style="color:var(--orange)">● Blend Signal</span><span>8 (17.0%)</span>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:12px">
          <span style="color:var(--muted)">● Unclassified</span><span>18 (38.3%)</span>
        </div>
      </div>
    </div>
  </div>

  <div class="grid2" style="margin-top:1.25rem">
    <div class="card">
      <div class="card-title">Model Performance</div>
      <div style="display:flex;flex-direction:column;gap:0.8rem;margin-top:0.5rem">
        <div>
          <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px">
            <span>XGBoost Accuracy</span><span class="c-green">92.4%</span>
          </div>
          <div class="progress-bar"><div class="progress-fill" style="width:92.4%;background:var(--green)"></div></div>
        </div>
        <div>
          <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px">
            <span>1D CNN Accuracy</span><span class="c-blue">89.1%</span>
          </div>
          <div class="progress-bar"><div class="progress-fill" style="width:89.1%;background:var(--accent)"></div></div>
        </div>
        <div>
          <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px">
            <span>Ensemble Accuracy</span><span class="c-gold">94.7%</span>
          </div>
          <div class="progress-bar"><div class="progress-fill" style="width:94.7%;background:var(--gold)"></div></div>
        </div>
        <div>
          <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px">
            <span>Precision (Planet)</span><span class="c-purple">91.2%</span>
          </div>
          <div class="progress-bar"><div class="progress-fill" style="width:91.2%;background:var(--accent2)"></div></div>
        </div>
      </div>
    </div>
    <div class="card">
      <div class="card-title">Top Candidates by SNR</div>
      <table class="data-table">
        <thead><tr>
          <th>TIC ID</th><th>SNR</th><th>Period</th><th>Class</th>
        </tr></thead>
        <tbody>
          <tr><td>260128333</td><td class="c-gold">14.2</td><td>3.47 d</td><td><span class="badge badge-green">Planet</span></td></tr>
          <tr><td>441420236</td><td class="c-gold">11.8</td><td>7.23 d</td><td><span class="badge badge-green">Planet</span></td></tr>
          <tr><td>338457655</td><td class="c-orange">9.4</td><td>2.10 d</td><td><span class="badge badge-red">EB FP</span></td></tr>
          <tr><td>122227780</td><td class="c-orange">8.7</td><td>14.5 d</td><td><span class="badge badge-green">Planet</span></td></tr>
          <tr><td>299798795</td><td class="c-muted">6.2</td><td>5.88 d</td><td><span class="badge badge-orange">Blend</span></td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- UPLOAD -->
<div class="section" id="sec-upload">
  <div class="page-header">
    <h2>Upload Light Curve Data</h2>
